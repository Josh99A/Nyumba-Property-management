.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control. Kept local
# here: the launch entries name personal device ids and ports.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# Per-developer DevTools extension enablement, regenerated on demand.
devtools_options.yaml

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase configuration (generated per-environment with `flutterfire configure`;
# regenerate locally, never commit — see README "Firebase configuration")
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
firebase_app_id_file.json
.firebaserc
.firebase/

# Service accounts and other secrets — never commit
*service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json
.env
.env.*
!.env.example

# Google Maps Platform keys. Restricted per platform in Google Cloud, but a
# restriction is not a secret: an unrestricted-by-accident key on a public
# marketplace is a way to lose real money to a stranger.
android/maps.properties

# Android release signing
android/key.properties
android/keys.properties
android/app/upload-keystore.jks
*.keystore
*.jks
