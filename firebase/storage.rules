rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isPlatformAdmin() {
      return signedIn()
        && (request.auth.token.platformAdmin == true
          || request.auth.token.superAdmin == true);
    }

    // Finalized limits (mirrored in lib/core/config/market_config.dart):
    // images (listing photos, maintenance media) 5 MB — jpeg/png/webp;
    // documents 10 MB — pdf.
    // Property photo counts (max 2), listing photo counts (max 5), ordering,
    // and checksum validation are enforced by the finalizing Cloud Function.
    function validImageUpload() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in
          ['image/jpeg', 'image/png', 'image/webp'];
    }

    function validDocumentUpload() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    function validStagingUpload() {
      return request.resource.contentType is string
        && (validImageUpload() || validDocumentUpload());
    }

    // Retiring a listing's media is a deletion, not a rule decision.
    //
    // This prefix used to be gated on a firestore.get of the listing's public
    // projection. That cost a billed document read and its latency on *every
    // image request* — fifty on a single marketplace page — in the critical
    // path of first paint, and it could not be cached. It also could not
    // enforce much: the delivery objects are served with a one-year immutable
    // lifetime, so once a client or CDN has a photo the rule is never consulted
    // again for it.
    //
    // Every route that retires a listing already enqueues `cleanupListingMedia`,
    // which deletes this whole prefix: unpublish, purge, expiry sweep, listing
    // retirement, and landlord suspension. Deleted objects are unreadable by
    // anyone, which is a stronger guarantee than a rule a cache can skip.
    //
    // The residual exposure is the gap between a listing ceasing to be public
    // and its cleanup job running — at most one hourly expiry sweep — during
    // which someone already holding the exact object URL could refetch a photo
    // that was, until then, deliberately published to a public marketplace.

    // Two-phase user staging area. A function validates checksum/type/ownership
    // and moves/copies accepted objects into a canonical private/public path.
    match /uploads/{uid}/{commandId}/{fileName} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && validStagingUpload();
      allow delete: if isSelf(uid);
    }

    // Server-projected listing assets. Uploading to staging never makes a file
    // public; publication must also create the Firestore public projection.
    match /public/listings/{listingId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Canonical private content. Backend code alone writes these prefixes.
    match /private/landlords/{landlordId}/{allPaths=**} {
      allow read: if isSelf(landlordId) || isPlatformAdmin();
      allow write: if false;
    }

    match /private/tenants/{tenantUid}/{allPaths=**} {
      allow read: if isSelf(tenantUid) || isPlatformAdmin();
      allow write: if false;
    }

    match /private/clients/{clientUid}/{allPaths=**} {
      allow read: if isSelf(clientUid) || isPlatformAdmin();
      allow write: if false;
    }

    match /private/admin/{allPaths=**} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
